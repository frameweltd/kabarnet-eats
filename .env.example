# ============================================================================
# Supabase — get these from your project's Settings > API page
# https://supabase.com/dashboard/project/_/settings/api
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — bypasses Row Level Security. NEVER expose this to the
# browser or commit it. Used only in server-side routes (M-Pesa callback,
# settlement jobs). Settings > API > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# M-Pesa Daraja API — get these from https://developer.safaricom.co.ke
# Create an app there, then use its Consumer Key/Secret. For go-live you'll
# also need a registered Paybill/Till number and the Lipa Na M-Pesa passkey.
# ============================================================================
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
MPESA_CALLBACK_URL=https://your-deployed-domain.vercel.app/api/mpesa/callback
